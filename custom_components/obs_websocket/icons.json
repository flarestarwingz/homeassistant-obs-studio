{
  "entity": {
    "sensor": {
      "stream_status": {
        "default": "mdi:broadcast",
        "state": {
          "streaming": "mdi:broadcast",
          "reconnecting": "mdi:broadcast-off",
          "idle": "mdi:broadcast-off"
        }
      },
      "stream_service": {
        "default": "mdi:cog-play"
      },
      "recording": {
        "default": "mdi:record-rec",
        "state": {
          "recording": "mdi:record-rec",
          "idle": "mdi:stop-circle-outline"
        }
      },
      "virtual_cam": {
        "default": "mdi:camera",
        "state": {
          "active": "mdi:video",
          "idle": "mdi:video-off"
        }
      }
    },
    "button": {
      "start_stream": {
        "default": "mdi:play"
      },
      "stop_stream": {
        "default": "mdi:stop"
      },
      "toggle_record": {
        "default": "mdi:record-rec"
      },
      "toggle_virtual_cam": {
        "default": "mdi:camera"
      }
    },
    "select": {
      "scene": {
        "default": "mdi:eye-arrow-right"
      }
    }
  }
}